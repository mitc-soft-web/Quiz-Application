@model Quiz_Application.Controllers.CourseDetailsViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Course.CourseName | Q-MSTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        :root { --mst-cyan: #00d2ff; --mst-dark: #0f172a; }
        body { background: #020617; color: white; font-family: 'Inter', sans-serif; min-height: 100vh; }
        
        .topic-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; }
        
        .topic-card {
            background: linear-gradient(145deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0.01) 100%);
            border: 1px solid rgba(0, 210, 255, 0.1);
            border-radius: 20px;
            padding: 2rem;
            transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .topic-card::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 4px; height: 100%;
            background: var(--mst-cyan);
            opacity: 0;
            transition: 0.3s;
        }

        .topic-card:hover {
            background: rgba(0, 210, 255, 0.08);
            border-color: var(--mst-cyan);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 210, 255, 0.1);
        }

        .topic-card:hover::before { opacity: 1; }

        .btn-action {
            background: var(--mst-cyan);
            color: var(--mst-dark);
            border: none;
            border-radius: 50px;
            padding: 0.6rem 1.5rem;
            font-weight: 700;
            text-transform: uppercase;
            font-size: 0.75rem;
            letter-spacing: 1px;
            text-decoration: none;
            transition: 0.2s;
            display: inline-block;
        }

        .btn-action:hover {
            background: white;
            color: var(--mst-dark);
            transform: scale(1.05);
        }

        .breadcrumb-tech { color: var(--mst-cyan); font-size: 0.8rem; font-weight: bold; letter-spacing: 1px; }
        .header-section { border-bottom: 1px solid rgba(255,255,255,0.1); margin-bottom: 3rem; padding-bottom: 2rem; }
    </style>
</head>
<body>

    <div class="container py-5">
        <!-- Header -->
        <div class="header-section">
            <div class="breadcrumb-tech mb-2">
                <a asp-action="Index" class="text-decoration-none text-info">DASHBOARD</a> 
                <span class="text-white-50"> > @((Model.Course.CourseName ?? "Course").ToUpper())</span>
            </div>
            <div class="d-flex justify-content-between align-items-end">
                <div>
                    <h1 class="fw-bold display-5">Neural Modules</h1>
                    <p class="text-white-50 m-0">Select a specialized data stream to initialize your assessment.</p>
                </div>
                <div class="text-end d-none d-md-block">
                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-3 py-2">
                        <i class="bi bi-cpu me-2"></i>AI GENERATED CONTENT
                    </span>
                </div>
            </div>
        </div>

        <!-- The Grid -->
        <div class="topic-grid">
            @if (Model.Topics != null && Model.Topics.Any())
            {
                foreach (var topic in Model.Topics)
                {
                    <div class="topic-card">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="bg-info bg-opacity-10 p-2 rounded">
                                    <i class="bi bi-terminal-fill text-info"></i>
                                </div>
                                <span class="text-white-50 small">READY</span>
                            </div>
                            
                            <h4 class="fw-bold mb-2">@topic.LanguageName</h4>
                            <p class="text-white-50 small mb-4">
                                Comprehensive evaluation of @topic.LanguageName core concepts and syntax logic.
                            </p>
                        </div>
                        
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <span class="text-muted small">
                                <i class="bi bi-clock me-1"></i> ~10 min
                            </span>
                            <a asp-controller="Quiz"
                               asp-action="Index"
                               asp-route-languageId="@topic.Id"
                               asp-route-languageName="@topic.LanguageName"
                               class="btn-action">
                                Initialize <i class="bi bi-lightning-fill ms-1"></i>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5 border border-secondary border-dashed rounded-4">
                    <i class="bi bi-cloud-slash display-4 text-muted mb-3"></i>
                    <p class="text-muted m-0">No neural topics indexed. Return to dashboard to resync.</p>
                    <a asp-action="Index" class="btn btn-outline-info btn-sm mt-3">Back to Hub</a>
                </div>
            }
        </div>
    </div>

</body>
</html>
