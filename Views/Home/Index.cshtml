@{
    ViewData["Title"] = "Q-MSTech";
}

<section class="py-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-7">
            <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-pill bg-info-subtle text-info-emphasis fw-bold small mb-4">
                <i class="bi bi-shield-check"></i> Professional technical assessments
            </div>
            <h1 class="display-4 fw-bold mb-3" style="font-family: 'Space Grotesk', sans-serif;">
                Q-MSTech Quiz Platform
            </h1>
            <p class="lead text-secondary mb-4">
                Select a technology topic, choose your skill level, and practice with focused questions generated for your chosen language or area.
            </p>
            <div class="d-flex gap-3 flex-wrap">
                <a asp-controller="User" asp-action="Login" class="btn btn-info btn-lg rounded-pill fw-bold px-4 text-dark">Login</a>
                <a asp-controller="User" asp-action="Register" class="btn btn-outline-dark btn-lg rounded-pill fw-bold px-4">Create Account</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="p-4 rounded-4 bg-white shadow-sm border">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <span class="brand-icon"><i class="bi bi-cpu"></i></span>
                    <div>
                        <div class="fw-bold">Q-MSTech Engine</div>
                        <div class="small text-muted">Quiz generation ready</div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-6"><div class="p-3 rounded-3 bg-light fw-bold text-primary">Programming</div></div>
                    <div class="col-6"><div class="p-3 rounded-3 bg-light fw-bold text-primary">Cybersecurity</div></div>
                    <div class="col-6"><div class="p-3 rounded-3 bg-light fw-bold text-primary">Cloud</div></div>
                    <div class="col-6"><div class="p-3 rounded-3 bg-light fw-bold text-primary">AI</div></div>
                </div>
            </div>
        </div>
    </div>
</section>
