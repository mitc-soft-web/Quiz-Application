@model Quiz_Application.Models.DTO.QuizDTO
@{
    Layout = null;
    var total = Model.TotalQuestions > 0 ? Model.TotalQuestions : Model.Questions.Count;
    var score = Model.Score;
    var percentage = total > 0 ? (score * 100.0 / total) : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quiz Review - Q-MSTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
    <style>
        :root { --mst-cyan: #06b6d4; --mst-blue: #2563eb; --mst-dark: #0f172a; }
        body { background: #f1f5f9; font-family: 'Inter', sans-serif; color: #1e293b; }
        .topbar { background: linear-gradient(135deg, var(--mst-dark), #111827); color: white; border-radius: 0 0 24px 24px; border-bottom: 1px solid rgba(6, 182, 212, 0.22); }
        .topbar h1 { font-family: 'Space Grotesk', sans-serif; }
        .review-card { border: 0; border-radius: 16px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06); }
        .answer-box { border-radius: 12px; padding: 14px 16px; border: 1px solid #e2e8f0; background: #fff; }
        .answer-box.correct { border-color: #22c55e; background: #ecfdf5; }
        .answer-box.wrong { border-color: #ef4444; background: #fef2f2; }
        .status-pill { border-radius: 999px; padding: 6px 12px; font-size: 0.75rem; font-weight: 800; }
    </style>
</head>
<body>
    <header class="topbar py-4 mb-5">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <div>
                    <h1 class="h3 fw-bold mb-1">Assessment Review</h1>
                    <p class="mb-0 text-white-50">@Model.LanguageName | @Model.Level</p>
                </div>
                <div class="text-end">
                    <div class="display-6 fw-bold">@score/@total</div>
                    <div class="text-info fw-bold">@percentage.ToString("F1")%</div>
                </div>
            </div>
        </div>
    </header>

    <main class="container pb-5" style="max-width: 960px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a asp-action="History" class="btn btn-outline-dark rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Back to History
            </a>
            <a asp-controller="Course" asp-action="Index" class="btn btn-dark rounded-pill">
                Dashboard
            </a>
        </div>

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            var userAnswer = q.UserSelection ?? "";
            var correctAnswer = q.CorrectAnswer ?? q.CorrectOption ?? "";
            var isCorrect = string.Equals(userAnswer.Trim(), correctAnswer.Trim(), StringComparison.OrdinalIgnoreCase);

            <section class="card review-card mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <h2 class="h6 fw-bold mb-0">Question @(i + 1)</h2>
                        @if (isCorrect)
                        {
                            <span class="status-pill bg-success text-white"><i class="bi bi-check-circle me-1"></i> Passed</span>
                        }
                        else
                        {
                            <span class="status-pill bg-danger text-white"><i class="bi bi-x-circle me-1"></i> Failed</span>
                        }
                    </div>

                    <p class="fw-semibold mb-4">@q.QuestionText</p>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="answer-box @(isCorrect ? "correct" : "wrong")">
                                <div class="small text-muted fw-bold text-uppercase mb-1">Your Answer</div>
                                <div>@(string.IsNullOrWhiteSpace(userAnswer) ? "No answer selected" : userAnswer)</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="answer-box correct">
                                <div class="small text-muted fw-bold text-uppercase mb-1">Correct Answer</div>
                                <div>@correctAnswer</div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        }
    </main>
</body>
</html>
