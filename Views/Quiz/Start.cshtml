@model Quiz_Application.Models.DTO.QuizDTO
@{
    ViewData["Title"] = "Q-MSTech | Initialization";
    Layout = null;
}

@if (Model == null)
{
    <div style="background: #0f172a; color: #ff4d4d; height: 100vh; display: flex; align-items: center; justify-content: center; flex-direction: column; font-family: 'Inter', sans-serif;">
        <i class="bi bi-exclamation-octagon fs-1 mb-3"></i>
        <h3 class="fw-bold">DATA STREAM NULL</h3>
        <p>Neural link could not be established. Model missing.</p>
        <a href="/User/Dashboard" style="color: #0d6efd; text-decoration: none; border: 1px solid #0d6efd; padding: 10px 20px; border-radius: 50px;">Return to Hub</a>
    </div>
    return;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background: radial-gradient(circle at top right, #1e293b, #0f172a); color: white; font-family: 'Inter', sans-serif; display: flex; align-items: center; min-height: 100vh; margin: 0; }
        .start-card { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 24px; padding: 3rem; backdrop-filter: blur(15px); }
        .btn-init { background: #0d6efd; color: white; border-radius: 50px; padding: 1rem 2.5rem; font-weight: bold; text-decoration: none; transition: 0.3s; box-shadow: 0 4px 15px rgba(13, 110, 253, 0.3); }
        .btn-init:hover { background: #0056b3; transform: translateY(-3px); box-shadow: 0 8px 25px rgba(13, 110, 253, 0.5); color: white; }
        .loader-ring { display: none; width: 20px; height: 20px; border: 3px solid rgba(255,255,255,.3); border-radius: 50%; border-top-color: #fff; animation: spin 1s ease-in-out infinite; margin-right: 10px; }
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <div class="container text-center">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="start-card shadow-lg animate__animated animate__fadeIn">
                    <div class="mb-4">
                        <i class="bi bi-cpu fs-1 text-info"></i>
                    </div>
                    
                    <h2 class="fw-bold mb-3">Initialize: @Model.LanguageName</h2>
                    <h5 class="text-white-50 mb-4">Module: @Model.Title</h5>

                    <div class="d-flex justify-content-center gap-3 mb-5">
                        <div class="px-3 py-1 bg-white bg-opacity-10 rounded-pill small">
                            <i class="bi bi-bar-chart-fill text-info me-1"></i> Level: @Model.Level
                        </div>
                        <div class="px-3 py-1 bg-white bg-opacity-10 rounded-pill small">
                            <i class="bi bi-clock text-info me-1"></i> Est. 15 Mins
                        </div>
                    </div>

                    <p class="text-white-50 mb-5 small text-uppercase tracking-widest">
                        Neural link ready. Prepare for data stream synchronization.
                    </p>
                    
                    <form asp-action="Start" asp-controller="Quiz" method="get" id="initForm">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <button type="submit" class="btn btn-init border-0 w-100 d-flex align-items-center justify-content-center" onclick="startLoading()">
                            <div class="loader-ring" id="btnLoader"></div>
                            <span>Establish Neural Link</span>
                        </button>
                    </form>
                    
                    <div class="mt-4">
                        <a asp-action="History" asp-controller="Quiz" class="text-muted small text-decoration-none hover-white">
                            <i class="bi bi-x-circle me-1"></i> Abort Sequence
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        function startLoading() {
            document.getElementById('btnLoader').style.display = 'inline-block';
            document.querySelector('.btn-init span').innerText = 'Syncing...';
        }
    </script>
</body>
</html>
