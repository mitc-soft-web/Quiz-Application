@model IEnumerable<Quiz_Application.Models.DTO.Quiz_Application.Models.DTO.SuggestionDto>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Study Plan - Q-MSTech</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <main class="container py-5" style="max-width: 900px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold mb-1">Study Plan</h1>
                <p class="text-muted mb-0">Recommended next steps from your assessment.</p>
            </div>
            <a asp-action="History" class="btn btn-outline-dark rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> History
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-3">
                @foreach (var item in Model)
                {
                    <div class="col-12">
                        <div class="card border-0 shadow-sm">
                            <div class="card-body p-4">
                                <p class="fw-semibold mb-3">@item.Suggestions</p>
                                @if (!string.IsNullOrWhiteSpace(item.ResourseLienk))
                                {
                                    <a href="@item.ResourseLienk" target="_blank" rel="noopener" class="btn btn-sm btn-info rounded-pill fw-bold">
                                        Open Resource <i class="bi bi-box-arrow-up-right ms-1"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border">
                <i class="bi bi-lightbulb display-5 text-muted"></i>
                <h4 class="mt-3">No suggestions available yet.</h4>
                <a asp-controller="Course" asp-action="Index" class="btn btn-primary rounded-pill mt-2">Back to Dashboard</a>
            </div>
        }
    </main>
</body>
</html>
