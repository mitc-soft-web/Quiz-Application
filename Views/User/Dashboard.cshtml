@model Quiz_Application.Models.DTO.User.UserDTO
@{
    ViewData["Title"] = "Q-MSTech | Terminal";
    var recentQuizzes = ViewBag.RecentQuizzes as IEnumerable<Quiz_Application.Models.DTO.QuizDTO>;
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Q-MSTech Command Console</title>
    
    <!-- Bootstrap & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@700&display=swap" rel="stylesheet">
    
    <style>
            :root {
                --mst-primary: #0d6efd;
                --mst-sidebar: #0f172a;
                --mst-bg: #f1f5f9;
                --mst-card: #ffffff;
                --mst-border: #e2e8f0;
                --mst-text-dark: #1e293b;
                --mst-text-muted: #64748b;
            }

            body {
                background-color: var(--mst-bg);
                font-family: 'Inter', sans-serif;
                color: var(--mst-text-dark);
            }

            .dashboard-wrapper {
                display: flex;
                min-height: 100vh;
            }

            /* Professional Sidebar */
            .sidebar {
                width: 260px;
                background: var(--mst-sidebar);
                color: white;
                position: fixed;
                height: 100vh;
                padding: 2.5rem 1.5rem;
                display: flex;
                flex-direction: column;
                z-index: 1000;
            }

            .sidebar-brand {
                font-family: 'Orbitron', sans-serif;
                font-size: 1.4rem;
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 3rem;
                color: white;
                text-decoration: none;
            }

            .nav-link-custom {
                color: #94a3b8;
                padding: 0.8rem 1rem;
                border-radius: 10px;
                display: flex;
                align-items: center;
                gap: 12px;
                transition: 0.3s;
                text-decoration: none;
                margin-bottom: 0.4rem;
                font-weight: 500;
            }

                .nav-link-custom:hover, .nav-link-custom.active {
                    background: rgba(13, 110, 253, 0.15);
                    color: #3b82f6;
                }

            /* Main Area */
            .main-content {
                flex: 1;
                margin-left: 260px;
                padding: 2rem 3rem;
            }

            header {
                margin-bottom: 2.5rem;
            }

            /* Metric Cards */
            .metric-card {
                background: var(--mst-card);
                border: 1px solid var(--mst-border);
                border-radius: 16px;
                padding: 1.5rem;
                transition: 0.3s;
            }

                .metric-card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05);
                }

            .metric-icon {
                width: 42px;
                height: 42px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                margin-bottom: 1rem;
            }

            /* Table Card */
            .data-table-card {
                background: var(--mst-card);
                border-radius: 20px;
                border: 1px solid var(--mst-border);
                padding: 1.5rem;
                box-shadow: 0 4px 6px -1px rgba(0,0,0,0.03);
            }

            .table thead th {
                background: #f8fafc;
                border-bottom: 1px solid var(--mst-border);
                color: var(--mst-text-muted);
                text-transform: uppercase;
                font-size: 0.7rem;
                letter-spacing: 1px;
                padding: 1rem;
            }

            .table tbody td {
                padding: 1rem;
                vertical-align: middle;
                border-bottom: 1px solid #f1f5f9;
            }

            .btn-mst {
                background: var(--mst-primary);
                color: white;
                border: none;
                border-radius: 10px;
                padding: 0.7rem 1.4rem;
                font-weight: 600;
                transition: 0.3s;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
            }

                .btn-mst:hover {
                    background: #0056b3;
                    transform: scale(1.02);
                    color: white;
                }

            .badge-level {
                padding: 4px 12px;
                border-radius: 20px;
                font-weight: 700;
                font-size: 0.7rem;
                background: #eff6ff;
                color: #1d4ed8;
                border: 1px solid #dbeafe;
            }
    </style>
</head>
<body>

    <div class="dashboard-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">
                <div style="background: var(--mst-primary); width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: white;">Q</div>
                <span>MS_TECH</span>
            </a>
        
            <nav class="d-flex flex-column h-100">
                <a href="#" class="nav-link-custom active"><i class="bi bi-grid-fill"></i> Overview</a>
                <a asp-action="Index" asp-controller="Course" class="nav-link-custom"><i class="bi bi-cpu-fill"></i> Neural Hub</a>
                <a asp-action="History" asp-controller="Quiz" class="nav-link-custom"><i class="bi bi-clock-history"></i> Sync History</a>
                <a href="#" class="nav-link-custom"><i class="bi bi-person-badge"></i> Profile</a>
            
                <div class="mt-auto">
                    <a asp-action="Logout" asp-controller="User" class="nav-link-custom text-danger opacity-75">
                        <i class="bi bi-power"></i> Terminate Link
                    </a>
                </div>
            </nav>
        </aside>

        <!-- Main Content Area -->
        <main class="main-content">
            <header class="d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1">Command Console</h2>
                    <p class="text-muted small mb-0">
                        Operator: <span class="text-primary fw-bold">@Model.UserName</span>
                        | Protocol: <span class="badge bg-success-subtle text-success border-0 rounded-pill">Secure</span>
                    </p>
                </div>
                <a asp-action="Index" asp-controller="Course" class="btn-mst">
                    <i class="bi bi-lightning-charge-fill me-2"></i> New Synchronization
                </a>
            </header>

            <!-- Metrics Matrix -->
            <div class="row g-4 mb-5">
                <div class="col-md-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-diagram-3"></i></div>
                        <p class="text-muted small mb-0 fw-bold">Active Syncs</p>
                        <h3 class="fw-bold mb-0">@recentQuizzes?.Count()</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-success bg-opacity-10 text-success"><i class="bi bi-bullseye"></i></div>
                        <p class="text-muted small mb-0 fw-bold">Neural Accuracy</p>
                        <h3 class="fw-bold mb-0">87.5%</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-activity"></i></div>
                        <p class="text-muted small mb-0 fw-bold">Cognitive Load</p>
                        <h3 class="fw-bold mb-0">Stable</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="metric-card">
                        <div class="metric-icon bg-info bg-opacity-10 text-info"><i class="bi bi-shield-check"></i></div>
                        <p class="text-muted small mb-0 fw-bold">Identity Class</p>
                        <h3 class="fw-bold mb-0">Analyst</h3>
                    </div>
                </div>
            </div>

            <!-- Recent Neural Stream Activity -->
            <div class="data-table-card">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0">Neural Stream Activity</h5>
                    <a asp-action="History" asp-controller="Quiz" class="text-decoration-none small fw-bold">
                        <i class="bi bi-list-nested me-1"></i> Full Log History
                    </a>
                </div>
            
                <div class="table-responsive">
                    <table class="table table-borderless align-middle">
                        <thead>
                            <tr>
                                <th>Data Subject</th>
                                <th>Logic Level</th>
                                <th>Last Sync Date</th>
                                <th class="text-end">Telemetry</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentQuizzes != null && recentQuizzes.Any())
                            {
                                foreach (var quiz in recentQuizzes)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <div class="p-2 bg-light rounded text-primary border"><i class="bi bi-terminal"></i></div>
                                                <span class="fw-bold">@quiz.LanguageName</span>
                                            </div>
                                        </td>
                                        <td><span class="badge-level">@quiz.Level</span></td>
                                        <td class="text-muted small">@quiz.CreatedDate.ToString("MMM dd, yyyy | HH:mm")</td>
                                        <td class="text-end">
                                            <a asp-action="Result" asp-controller="Quiz" asp-route-quizId="@quiz.Id" class="btn btn-sm btn-outline-primary px-3 rounded-pill fw-bold">
                                                Analyze
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <i class="bi bi-cloud-slash display-6 text-muted mb-3 d-block"></i>
                                        <p class="text-muted mb-0">No neural data streams found. Start a new synchronization to populate the terminal.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

</body>
</html>