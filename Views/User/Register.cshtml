@{ Layout = null; }
@model Quiz_Application.Models.DTO.User.CreateUserRequestModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Q-MSTech | Initialize Identity</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Space+Grotesk:wght@700&display=swap" rel="stylesheet">
    <style>
        :root { --primary: #00d2ff; --bg: #0f172a; }
        body { 
            background: radial-gradient(circle at bottom left, #1e293b, #0f172a); 
            font-family: 'Inter', sans-serif; 
            color: white; 
            min-height: 100vh; 
            display: flex; 
            align-items: center; 
        }
        .auth-card { 
            background: rgba(255, 255, 255, 0.03); 
            border: 1px solid rgba(255,255,255,0.1); 
            border-radius: 2rem; 
            backdrop-filter: blur(12px); 
        }
        .logo-text { font-family: 'Space Grotesk', sans-serif; font-weight: 700; color: var(--primary); }
        .form-control { 
            background: rgba(255,255,255,0.05); 
            border: 1px solid rgba(255,255,255,0.1); 
            color: white !important; 
            padding: 0.8rem 1.2rem; 
            border-radius: 12px;
        }
        .form-control:focus { 
            background: rgba(255,255,255,0.1); 
            border-color: var(--primary); 
            box-shadow: 0 0 15px rgba(0, 210, 255, 0.2); 
        }
        .btn-tech { 
            background: var(--primary); 
            color: var(--bg); 
            font-weight: 700; 
            border-radius: 50px; 
            transition: 0.3s;
        }
        .btn-tech:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 210, 255, 0.4);
            color: var(--bg);
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="auth-card p-5 shadow-lg">
                    <div class="text-center mb-4">
                        <h1 class="logo-text mb-2"><i class="bi bi-shield-plus"></i> Q-MS<span class="text-white">Tech</span></h1>
                        <p class="text-white-50 small text-uppercase tracking-widest">New Identity Protocol</p>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger border-0 bg-danger bg-opacity-25 text-white small rounded-4">
                            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
                        </div>
                    }

                    <form asp-action="Register" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label class="form-label small fw-bold">Username</label>
                                <input asp-for="UserName" class="form-control" placeholder="Operator_Name" required />
                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Email Address</label>
                            <input asp-for="Email" type="email" class="form-control" placeholder="link@network.tech" required />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold">Secure Password</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-tech w-100 py-3 mb-3">Initialize Identity</button>
                    </form>
                    
                    <div class="text-center small">
                        <span class="opacity-50">Already Indexed?</span> 
                        <a asp-action="Login" class="text-info text-decoration-none fw-bold ms-1">Access Terminal</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>